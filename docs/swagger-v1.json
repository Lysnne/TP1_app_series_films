{
  "openapi": "3.0.3",
  "info": { 
    "title": "TV Tracker API v1", 
    "version": "1.0.0", 
    "description": "Deprecated. Read-only minimal endpoints. ",
    "contact": {
      "email": "support@tvtracker.com"
    }
  },
  "servers": [{ 
    "url": "/api/v1",
    "description": "Deprecated API endpoint."
  }],
  "paths": {
    "/shows": {
      "get": {
        "summary": "List all TV shows",
        "description": "Deprecated: This endpoint is deprecated and will be removed in future versions. Use /v2/shows instead.",
        "deprecated": true,
        "responses": {
          "200": {
            "description": "A list of TV shows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Show"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/shows/{id}": {
      "get": {
        "summary": "Get TV show by ID",
        "description": "Deprecated: This endpoint is deprecated and will be removed in future versions. Use /v2/shows/{id} instead.",
        "deprecated": true,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the show to return"
          }
        ],
        "responses": {
          "200": {
            "description": "The TV show data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Show"
                }
              }
            }
          },
          "404": {
            "description": "Show not found"
          }
        }
      }
    },
    "/movies": {
      "get": {
        "summary": "List all movies",
        "description": "Deprecated: This endpoint is deprecated and will be removed in future versions. Use /v2/movies instead.",
        "deprecated": true,
        "responses": {
          "200": {
            "description": "A list of movies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Movie"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/movies/{id}": {
      "get": {
        "summary": "Get movie by ID",
        "description": "Deprecated: This endpoint is deprecated and will be removed in future versions. Use /v2/movies/{id} instead.",
        "deprecated": true,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the movie to return"
          }
        ],
        "responses": {
          "200": {
            "description": "The movie data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          },
          "404": {
            "description": "Movie not found"
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Search for content",
        "description": "Deprecated: This endpoint is deprecated and will be removed in future versions. Use /v2/search instead.",
        "deprecated": true,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search query"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["all", "movie", "show"]
            },
            "description": "Type of content to search for"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "movies": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Movie"
                      }
                    },
                    "shows": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Show"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Show": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "overview": {
            "type": "string"
          },
          "first_air_date": {
            "type": "string",
            "format": "date"
          },
          "poster_path": {
            "type": "string"
          },
          "backdrop_path": {
            "type": "string"
          },
          "vote_average": {
            "type": "number",
            "format": "float"
          },
          "status": {
            "type": "string",
            "enum": ["Returning Series", "Ended", "Canceled", "In Production", "Pilot", "Planned", "Other"]
          }
        }
      },
      "Movie": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "overview": {
            "type": "string"
          },
          "release_date": {
            "type": "string",
            "format": "date"
          },
          "poster_path": {
            "type": "string"
          },
          "backdrop_path": {
            "type": "string"
          },
          "vote_average": {
            "type": "number",
            "format": "float"
          },
          "runtime": {
            "type": "integer",
            "description": "Runtime in minutes"
          }
        }
      }
    }
  }
}
